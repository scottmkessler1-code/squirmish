{
  "name": "squirmish",
  "version": "0.1.0",
  "private": true,
  "description": "Caterpillar Continental Combat, online multiplayer",
  "scripts": {
    "start": "node server/index.js",
    "check:browser": "NODE_PATH=$(npm root -g) node test/browser.check.js",
    "check:online": "NODE_PATH=$(npm root -g) node test/online.check.js",
    "check:restart": "NODE_PATH=$(npm root -g) node test/restart.check.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.22.3",
    "ws": "^8.22.0"
  }
}
